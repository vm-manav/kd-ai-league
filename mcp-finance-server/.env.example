PORT=8080
MCP_PATH=/mcp
SERVER_BASE_URL=http://localhost:8080

# OAuth Resource Server config
OAUTH_ISSUER=http://localhost:8081/realms/mcp-finance
OAUTH_JWKS_URI=http://keycloak:8080/realms/mcp-finance/protocol/openid-connect/certs
OAUTH_AUDIENCE=mcp-finance-server
OAUTH_AUTHORIZATION_SERVER=http://localhost:8081/realms/mcp-finance
OAUTH_TIER_CLAIM=https://kd-ai-league.example.com/tier
OAUTH_ROLES_CLAIM=https://kd-ai-league.example.com/roles

# Local hackathon shortcut. Set false for judged demo.
AUTH_BYPASS=true

# Upstream provider keys (add as available)
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
NEWSAPI_API_KEY=
GNEWS_API_KEY=
